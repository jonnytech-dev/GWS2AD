# Copy to .env only if you want to change a default. `python setup_secrets.py`
# creates .env for you with the one required value (SECRETS_KEY).

# Required. Created by setup_secrets.py. Decrypts secrets.json.enc. Keep it secret.
# SECRETS_KEY=

# Where the web app listens. The default (127.0.0.1) means this computer only.
# GWS2AD_HOST=0.0.0.0
# GWS2AD_PORT=5000

# Turn on once cert.pem and key.pem exist next to app.py (see docs/deployment.md).
# USE_HTTPS=true
